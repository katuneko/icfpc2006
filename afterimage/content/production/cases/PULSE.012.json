  "story": {
    "premise": "The correction archive reaches the hearing out of order. A later fragment may be authentic and early, but publishing it before every lower index would turn absence into narrative choice. The bounded stream contains each index at most once; silence is not permission to skip.",
    "submission": "Submit a five-cell controller that buffers indices 0–3 and emits one canonical release token for every newly contiguous index, draining the full prefix at the arrival tick that closes the gap.",
    "diagnostics": "The exhaustive oracle covers 1,457 unique bounded streams, including same-tick canonical ordering, empty prefixes, late zero, and multi-item drains. It rejects arrival-order forwarding and one-item-only drains.",
    "hints": [
      "Track arrival separately from release.",
      "The next expected index only moves forward.",
      "One event can legitimately cause several outputs."
    ]
  }
