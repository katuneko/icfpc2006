    "reference_scale": 2100000,
    "requires": {
      "all": [
        "case:PULSE.012",
        "case:CASCADE.019"
      ]
    },
    "projection": "pulse.circuit-breaker",
    "validator_template": "pulse-program-claim/0.1",
    "author_program": {
      "format": "afterimage-pulse/0.1",
      "cells": [
        {
          "name": "mode",
          "type": "int",
          "initial": 0
        },
        {
          "name": "failures",
          "type": "int",
          "initial": 0
        },
        {
          "name": "opened_at",
          "type": "int",
          "initial": -2
        }
      ],
      "handlers": [
        {
          "id": "circuit.request",
          "on": "hearing.request",
          "actions": [
            {
              "op": "when",
              "condition": [
                "eq",
                [
                  "cell",
                  "mode"
                ],
                [
                  "const",
                  0
                ]
              ],
              "actions": [
                {
                  "op": "emit",
                  "topic": "hearing.admit",
                  "payload": [
                    "event",
                    "payload"
                  ]
                }
              ]
            },
            {
              "op": "when",
              "condition": [
                "and",
                [
                  "eq",
                  [
                    "cell",
                    "mode"
                  ],
                  [
                    "const",
                    1
                  ]
                ],
                [
                  "le",
                  [
                    "cell",
                    "opened_at"
                  ],
                  [
                    "sub",
                    [
                      "event",
                      "at"
                    ],
                    [
                      "const",
                      2
                    ]
                  ]
                ]
              ],
              "actions": [
                {
                  "op": "emit",
                  "topic": "hearing.probe",
                  "payload": [
                    "event",
                    "payload"
                  ]
                },
                {
                  "op": "set",
                  "cell": "mode",
                  "value": [
                    "const",
                    2
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "circuit.failure",
          "on": "hearing.failure",
          "actions": [
            {
              "op": "when",
              "condition": [
                "eq",
                [
                  "cell",
                  "mode"
                ],
                [
                  "const",
                  2
                ]
              ],
              "actions": [
                {
                  "op": "set",
                  "cell": "mode",
                  "value": [
                    "const",
                    1
                  ]
                },
                {
                  "op": "set",
                  "cell": "opened_at",
                  "value": [
                    "event",
                    "at"
                  ]
                }
              ]
            },
            {
              "op": "when",
              "condition": [
                "eq",
                [
                  "cell",
                  "mode"
                ],
                [
                  "const",
                  0
                ]
              ],
              "actions": [
                {
                  "op": "set",
                  "cell": "failures",
                  "value": [
                    "add",
                    [
                      "cell",
                      "failures"
                    ],
                    [
                      "const",
                      1
                    ]
                  ]
                }
              ]
            },
            {
              "op": "when",
              "condition": [
                "and",
                [
                  "eq",
                  [
                    "cell",
                    "mode"
                  ],
                  [
                    "const",
                    0
                  ]
                ],
                [
                  "le",
                  [
                    "const",
                    2
                  ],
                  [
                    "cell",
                    "failures"
                  ]
                ]
              ],
              "actions": [
                {
                  "op": "set",
                  "cell": "mode",
                  "value": [
                    "const",
                    1
                  ]
                },
                {
                  "op": "set",
                  "cell": "failures",
                  "value": [
                    "const",
                    0
                  ]
                },
                {
                  "op": "set",
                  "cell": "opened_at",
                  "value": [
                    "event",
                    "at"
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "circuit.success",
          "on": "hearing.success",
          "actions": [
            {
              "op": "when",
              "condition": [
                "eq",
                [
                  "cell",
                  "mode"
                ],
                [
                  "const",
                  2
                ]
              ],
              "actions": [
                {
                  "op": "set",
                  "cell": "mode",
                  "value": [
                    "const",
                    0
                  ]
                },
                {
                  "op": "set",
                  "cell": "failures",
                  "value": [
                    "const",
                    0
                  ]
                }
              ]
            },
            {
              "op": "when",
              "condition": [
                "eq",
                [
                  "cell",
                  "mode"
                ],
                [
                  "const",
                  0
                ]
              ],
              "actions": [
                {
                  "op": "set",
                  "cell": "failures",
                  "value": [
                    "const",
                    0
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "author_invariant": "mode 0/1/2 means closed/open/half-open. failures counts only consecutive closed-state failures; opened_at anchors a two-tick cooldown. The first eligible request is the sole probe, whose success closes and whose failure reopens the circuit.",
    "pulse_contract": {
      "task": "circuit-breaker",
      "input_topics": {
        "request": "hearing.request",
        "failure": "hearing.failure",
        "success": "hearing.success"
      },
      "timer_topic": "pulse.timer",
      "output_topics": {
        "admit": "hearing.admit",
        "probe": "hearing.probe"
      },
      "failure_threshold": 2,
      "cooldown_ticks": 2,
      "horizon": 4,
      "max_commands": 4,
      "named_fixtures": [
        [
          {
            "at": 0,
            "source": "failure"
          },
          {
            "at": 1,
            "source": "failure"
          },
          {
            "at": 2,
            "source": "request"
          },
